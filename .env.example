# ─────────────────────────────────────────────────────────────────────────────
# Trade-agent — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / Claude ───────────────────────────────────────────────────────────────
# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for analysis and decision-making
CLAUDE_MODEL=claude-sonnet-4-6

# ── News Sources ──────────────────────────────────────────────────────────────
# NewsAPI key — get one at https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# ── Broker / Exchange ─────────────────────────────────────────────────────────
# Zerodha Kite Connect (primary broker)
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_kite_access_token

# ── Safety Settings ───────────────────────────────────────────────────────────
# CRITICAL: Set to "true" to paper-trade without placing real orders.
# Default is "true" — change to "false" only when ready for live trading.
DRY_RUN=true

# Maximum capital to deploy per single trade (INR)
MAX_TRADE_AMOUNT=10000

# Maximum total open positions at any time
MAX_OPEN_POSITIONS=5

# Maximum positions in any single sector (prevents correlated blow-ups)
MAX_SECTOR_POSITIONS=2

# Stop-loss percentage per trade (e.g., 0.02 = 2%)
STOP_LOSS_PCT=0.02

# Take-profit percentage per trade (e.g., 0.04 = 4%)
TAKE_PROFIT_PCT=0.04

# Kill switch — set to "true" to halt ALL trading immediately
KILL_SWITCH=false

# ── Watchlist ─────────────────────────────────────────────────────────────────
# Comma-separated NSE symbols to watch (no suffix needed; agent adds .NS)
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,WIPRO,AXISBANK,BAJFINANCE,TATAMOTORS,ITC

# ── Agent Behaviour ───────────────────────────────────────────────────────────
# How often the agent runs its full analysis loop (minutes)
# 5 minutes is a good default for active day trading.
# Set to 1 for the most aggressive scanning (watch API rate limits).
ANALYSIS_INTERVAL_MINUTES=5

# Minimum combined signal score (0.0–1.0) required to trigger a trade
MIN_SIGNAL_SCORE=0.65

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Write logs to file in addition to stdout (optional path)
LOG_FILE=logs/trade_agent.log
